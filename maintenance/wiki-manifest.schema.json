{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetsGal local Wiki package manifest",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "id",
    "version",
    "revision",
    "title",
    "status"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "enum": [
        "plugin",
        "reference",
        "personal"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "available",
        "paused"
      ]
    },
    "documents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "path": {
            "type": "string",
            "description": "A relative Markdown file inside the manifest directory, checked by the generator."
          }
        }
      }
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "documents"
        ],
        "properties": {
          "documents": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 61
        },
        "groups": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "documents"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "summary": {
                "type": "string",
                "maxLength": 400
              },
              "documents": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
